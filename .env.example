# Optional local data collection.
# Copy to .env, fill values, then source it before running scripts:
# set -a; source .env; set +a

# Optional for higher GitHub API limits when collecting activity or scouting repos.
GITHUB_TOKEN=

# Required only for local Cloudflare site statistics collection.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_TAG=
SITE_STATS_HOSTNAME=zzuli.dev
